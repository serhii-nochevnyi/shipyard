FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gh \
    jq \
    make \
    openssh-client \
    procps \
    python3 \
    python3-pip \
    python3-venv \
    rsync \
    sudo \
    tar \
    unzip \
    xz-utils \
    zip \
    gzip \
  && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=24.15.0
ARG GO_VERSION=1.26.3
ARG KUBECTL_VERSION=v1.30.10
ARG HELM_VERSION=v3.17.3
ARG CLAUDE_CODE_VERSION=2.1.200
ARG CONTEXT7_MCP_VERSION=2.2.5
ARG TYPESCRIPT_LANGUAGE_SERVER_VERSION=5.2.0
ARG TYPESCRIPT_VERSION=6.0.3
# Required, deliberately without a default: this identity authors every commit
# made inside the container, so a baked-in fallback silently attributes work to
# whoever wrote it down. The build fails below when either is empty.
ARG GIT_USER_NAME=""
ARG GIT_USER_EMAIL=""

COPY .build/ssh-config/ /tmp/ssh-config/

RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) node_arch=linux-x64; go_arch=linux-amd64; kubectl_arch=amd64; helm_arch=amd64 ;; \
    arm64) node_arch=linux-arm64; go_arch=linux-arm64; kubectl_arch=arm64; helm_arch=arm64 ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  mkdir -p /usr/local/src; \
  curl -fsSLo "/usr/local/src/node-v${NODE_VERSION}-${node_arch}.tar.xz" "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-${node_arch}.tar.xz"; \
  curl -fsSLo /usr/local/src/SHASUMS256.txt "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
  (cd /usr/local/src && grep " node-v${NODE_VERSION}-${node_arch}.tar.xz\$" SHASUMS256.txt | sha256sum -c -); \
  tar -C /usr/local -xJf "/usr/local/src/node-v${NODE_VERSION}-${node_arch}.tar.xz"; \
  ln -sfn "/usr/local/node-v${NODE_VERSION}-${node_arch}" /usr/local/node; \
  ln -sfn /usr/local/node/bin/node /usr/local/bin/node; \
  ln -sfn /usr/local/node/bin/npm /usr/local/bin/npm; \
  ln -sfn /usr/local/node/bin/npx /usr/local/bin/npx; \
  ln -sfn /usr/local/node/bin/corepack /usr/local/bin/corepack; \
  corepack enable; \
  corepack prepare pnpm@10.10.0 --activate; \
  corepack prepare yarn@1.22.22 --activate; \
  npm install -g \
    pnpm@10.10.0 \
    yarn@1.22.22 \
    "@upstash/context7-mcp@${CONTEXT7_MCP_VERSION}" \
    "typescript-language-server@${TYPESCRIPT_LANGUAGE_SERVER_VERSION}" \
    "typescript@${TYPESCRIPT_VERSION}" \
    "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
  curl -fsSLo "/usr/local/src/go${GO_VERSION}.${go_arch}.tar.gz" "https://dl.google.com/go/go${GO_VERSION}.${go_arch}.tar.gz"; \
  curl -fsSLo "/usr/local/src/go${GO_VERSION}.${go_arch}.tar.gz.sha256" "https://dl.google.com/go/go${GO_VERSION}.${go_arch}.tar.gz.sha256"; \
  (cd /usr/local/src && printf '%s  %s\n' "$(tr -d ' \t\r\n' < "go${GO_VERSION}.${go_arch}.tar.gz.sha256")" "go${GO_VERSION}.${go_arch}.tar.gz" | sha256sum -c -); \
  rm -rf /usr/local/go; \
  tar -C /usr/local -xzf "/usr/local/src/go${GO_VERSION}.${go_arch}.tar.gz"; \
  curl -fsSLo /usr/local/src/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kubectl_arch}/kubectl"; \
  curl -fsSLo /usr/local/src/kubectl.sha256 "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kubectl_arch}/kubectl.sha256"; \
  (cd /usr/local/src && printf '%s  %s\n' "$(tr -d ' \t\r\n' < kubectl.sha256)" "kubectl" | sha256sum -c -); \
  install -m 0755 /usr/local/src/kubectl /usr/local/bin/kubectl; \
  chmod +x /usr/local/bin/kubectl; \
  curl -fsSLo "/usr/local/src/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz" "https://get.helm.sh/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz"; \
  curl -fsSLo "/usr/local/src/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz.sha256sum" "https://get.helm.sh/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz.sha256sum"; \
  (cd /usr/local/src && grep " helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz\$" "helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz.sha256sum" | sha256sum -c -); \
  tar -C /usr/local/src -xzf "/usr/local/src/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz"; \
  mv "/usr/local/src/linux-${helm_arch}/helm" /usr/local/bin/helm; \
  chmod +x /usr/local/bin/helm; \
  rm -f "/usr/local/src/node-v${NODE_VERSION}-${node_arch}.tar.xz" /usr/local/src/SHASUMS256.txt "/usr/local/src/go${GO_VERSION}.${go_arch}.tar.gz" "/usr/local/src/go${GO_VERSION}.${go_arch}.tar.gz.sha256" /usr/local/src/kubectl /usr/local/src/kubectl.sha256 "/usr/local/src/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz" "/usr/local/src/helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz.sha256sum"; \
  rm -rf "/usr/local/src/linux-${helm_arch}"

RUN if [ -z "$GIT_USER_NAME" ] || [ -z "$GIT_USER_EMAIL" ]; then \
      echo "GIT_USER_NAME and GIT_USER_EMAIL build args are required (they become the container's git identity):" >&2; \
      echo "  docker build -f Dockerfile.base --build-arg GIT_USER_NAME=\"Your Name\" --build-arg GIT_USER_EMAIL=you@example.com ." >&2; \
      echo "or use: make build-base GIT_USER_NAME=... GIT_USER_EMAIL=..." >&2; \
      exit 1; \
    fi

RUN userdel -r ubuntu || true \
  && useradd --uid 1000 --create-home --home-dir /home/dev --shell /bin/bash dev \
  && mkdir -p /workspace /home/dev/go /home/dev/.local/bin /home/dev/.ssh \
  && chmod 700 /home/dev/.ssh \
  && if [ -d /tmp/ssh-config ]; then cp -a /tmp/ssh-config/. /home/dev/.ssh/; fi \
  && find /home/dev/.ssh -maxdepth 1 -type f -exec chmod 600 {} \; \
  && git config --file /home/dev/.gitconfig user.name "$GIT_USER_NAME" \
  && git config --file /home/dev/.gitconfig user.email "$GIT_USER_EMAIL" \
  && git config --file /home/dev/.gitconfig init.defaultBranch main \
  && git config --file /home/dev/.gitconfig push.autoSetupRemote true \
  && git config --file /home/dev/.gitconfig color.ui auto \
  && git config --file /home/dev/.gitconfig fetch.prune true \
  && git config --file /home/dev/.gitconfig pull.rebase false \
  && git config --file /home/dev/.gitconfig pull.ff only \
  && chown -R dev:dev /workspace /home/dev \
  && chmod 700 /home/dev/.ssh \
  && rm -rf /tmp/ssh-config

# Late COPY on purpose: config tweaks must not invalidate the toolchain layer above.
COPY config/mcp-config.default.json /usr/local/share/claude-shipyard/mcp-config.default.json

ENV HOME=/home/dev \
    SHELL=/bin/bash \
    WORKSPACE=/workspace \
    GOPATH=/home/dev/go \
    PATH=/usr/local/node/bin:/usr/local/go/bin:/home/dev/go/bin:/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin

WORKDIR /workspace
USER dev
