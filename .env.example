# Claude Code subscription OAuth token (from `claude setup-token` on the host).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: GitHub auth passthrough for git/gh inside the container.
GITHUB_TOKEN=
GH_TOKEN=

# SSH agent forwarding: host-side socket to bind into the container.
# Default (empty) = macOS Docker Desktop proxy (/run/host-services/ssh-auth.sock).
# On a Linux host set: SSH_AUTH_SOCK_HOST=$SSH_AUTH_SOCK
SSH_AUTH_SOCK_HOST=

# Persisted Claude credentials file (holds remote-MCP OAuth, e.g. Atlassian Rovo).
CLAUDE_CREDENTIALS_FILE=./.claude-credentials.json

# Pinned gsd-core version (default). Override here to use a different release.
GSD_CORE_VERSION=1.7.0
