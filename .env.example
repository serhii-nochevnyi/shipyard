# Claude Code subscription OAuth token (from `claude setup-token` on the host).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: GitHub auth passthrough for git/gh inside the container.
GITHUB_TOKEN=
GH_TOKEN=

# SSH agent forwarding: host-side socket to bind into the container.
# Default (empty) = macOS Docker Desktop proxy (/run/host-services/ssh-auth.sock).
# On a Linux host set: SSH_AUTH_SOCK_HOST=$SSH_AUTH_SOCK
SSH_AUTH_SOCK_HOST=

# Persisted Claude credentials file (holds remote-MCP OAuth, e.g. Atlassian Rovo).
CLAUDE_CREDENTIALS_FILE=./.claude-credentials.json

# Pinned gsd-core version (default). Override here to use a different release.
GSD_CORE_VERSION=1.7.0

CLAUDE_STATE_DIR=./.claude-state
SSH_DIR=

# Pin what the `fable` alias resolves to. The delivery conveyor can only emit an
# ALIAS — the Agent tool validates `model` against opus|sonnet|haiku|fable, so no
# dispatch can name a full model id — and on any CLI below 2.1.255 that alias
# resolves to Fable 5 instead of Fable 5.1. This variable bypasses the built-in
# mapping and passes the id straight to the API, so it holds whatever version the
# host runs: the image pin is the brace, this is the belt, and it is what protects
# a host the image pin does not govern.
ANTHROPIC_DEFAULT_FABLE_MODEL=claude-fable-5-1